# 本地开发配置：npm run dev 和 npm run dev:db 共用此文件。
# 本机运行应用，通过映射端口连接 Docker 数据库。
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=__APP_NAME__
PGDATABASE=__APP_NAME__
PGPASSWORD=__APP_NAME__-dev-password
SERVER_HTTP_PORT=__HTTP_PORT__
DEV_POSTGRES_CONTAINER_NAME=__APP_NAME__-PostgreSQL-dev
# 相对于项目根目录；开发数据与生产数据分开。
DEV_POSTGRES_DATA_PATH=./data/postgres-dev
