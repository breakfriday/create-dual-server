SERVER_IMAGE=__APP_NAME__:0.1.0
SERVER_HTTP_PORT=__HTTP_PORT__
SERVER_BIND_IP=0.0.0.0
SERVER_UID=1000
SERVER_GID=1000
# 宿主机目录，相对路径以 compose.yaml 所在目录为基准。
SERVER_UPLOAD_PATH=./data/uploads
SERVER_LOG_PATH=./data/logs
# build:docker 自动生成；手工部署时必须填写随机值，升级保留原值。
COOKIE_KEYS=
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_CONTAINER_NAME=__APP_NAME__-PostgreSQL
POSTGRES_USER=__APP_NAME__
POSTGRES_DB=__APP_NAME__
POSTGRES_PASSWORD=
POSTGRES_DATA_PATH=./data/postgres
