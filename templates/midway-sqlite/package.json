{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "MidwayJS server with SQLite and portable Windows and Docker deployment",
  "engines": { "node": "22.x || 24.x" },
  "scripts": {
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "build": "mwtsc --cleanOutDir",
    "start": "node bootstrap.js",
    "check": "tsc --noEmit",
    "test": "node --test scripts/test/*.test.cjs",
    "test:production": "npm run build && node scripts/smoke-production.cjs --http",
    "build:docker": "node scripts/build-docker.cjs",
    "build:winserver": "node scripts/build-winserver.cjs"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "4.2.1",
    "@midwayjs/core": "4.2.1",
    "@midwayjs/koa": "4.2.1",
    "@midwayjs/logger": "4.0.1",
    "@midwayjs/typeorm": "4.2.1",
    "better-sqlite3": "12.11.1",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@midwayjs/mock": "4.2.1",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "mwtsc": "^1.4.0",
    "typescript": "^5.3.0"
  }
}
